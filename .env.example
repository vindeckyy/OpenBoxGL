# Put real secrets in ~/.env only (NOT in this repo).
# Copy nothing from here into tracked files.
#
# load_dotenv() drops any key that is not in env_config.ENV_KEYS, so a key set
# here but absent from that allowlist is silently ignored. Every credential key
# in this file is in that allowlist and is genuinely loaded. The process-only
# variables are in their own marked section: they are NOT in the allowlist, so
# they are read straight from the environment and must be exported instead.

# GitHub personal access token (optional, used for release API rate limits)
# GITHUB_TOKEN=
# Aliases accepted: GH_TOKEN, OPENBOX_GITHUB_TOKEN
# GH_TOKEN=
# OPENBOX_GITHUB_TOKEN=

# ---------------------------------------------------------------------
# Process-only variables: read from the environment, NOT from a .env file.
# load_dotenv() drops them, so set them by exporting before launch:
#   export OPENBOX_SAFE_MODE=1
# ---------------------------------------------------------------------

# Data directory override (read at import time, so export before launch)
# OPENBOX_DATA_DIR=

# Explicit env file path, checked before the data-directory roots
# OPENBOX_ENV_FILE=

# SQLite read model (optional; self-enables at 5000+ games, explicit 0 opts out)
# OPENBOX_ENABLE_SQLITE_READ=

# Unsandboxed plugins (disables the bubblewrap sandbox entirely, even when available)
# OPENBOX_ALLOW_UNSANDBOXED_PLUGINS=

# Safe mode: disables plugin execution process-wide (library and
# library_source hooks, before_launch/after_session, events) and the webhook
# dispatcher, and reports safe_mode in the capabilities response
# OPENBOX_SAFE_MODE=

# Steam shortcut launcher override (executable used for Steam shortcut plans)
# OPENBOX_EXECUTABLE=

# Stripe secret key (optional, maintainers only; for scripts/create_stripe_donate_link.sh)
# Never commit real values. Create payment links locally; only the public donate URL goes in README.
# STRIPE_SECRET_KEY=

# IGDB metadata (optional; Twitch developer app credentials)
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# RetroAchievements (optional; enables RA matching and progress without the UI form)
# RETROACHIEVEMENTS_USERNAME=
# RETROACHIEVEMENTS_API_KEY=
# Aliases accepted: RA_USERNAME, OPENBOX_RA_USERNAME, RA_API_KEY, OPENBOX_RA_API_KEY, RETROACHIEVEMENTS_KEY
# RA_USERNAME=
# OPENBOX_RA_USERNAME=
# RA_API_KEY=
# OPENBOX_RA_API_KEY=
# RETROACHIEVEMENTS_KEY=

# SteamGridDB artwork provider (optional; enables artwork search, apply, and bulk matching)
# STEAMGRIDDB_API_KEY=
# Alias accepted: OPENBOX_STEAMGRIDDB_API_KEY
# OPENBOX_STEAMGRIDDB_API_KEY=

# EmuMovies (optional; licensed account required for media downloads)
# EMUMOVIES_USERNAME=
# EMUMOVIES_PASSWORD=
# Aliases accepted: OPENBOX_EMUMOVIES_USERNAME, OPENBOX_EMUMOVIES_PASSWORD
# OPENBOX_EMUMOVIES_USERNAME=
# OPENBOX_EMUMOVIES_PASSWORD=

# ScreenScraper (required for per-ROM-hash scraping; dev id/password optional)
# SCREENSCRAPER_USER=
# SCREENSCRAPER_PASSWORD=
# SCREENSCRAPER_DEV_ID=
# SCREENSCRAPER_DEV_PASSWORD=

# Aliases accepted: OPENBOX_SCREENSCRAPER_USER, OPENBOX_SCREENSCRAPER_PASSWORD, OPENBOX_SCREENSCRAPER_DEV_ID, OPENBOX_SCREENSCRAPER_DEV_PASSWORD
# OPENBOX_SCREENSCRAPER_USER=
# OPENBOX_SCREENSCRAPER_PASSWORD=
# OPENBOX_SCREENSCRAPER_DEV_ID=
# OPENBOX_SCREENSCRAPER_DEV_PASSWORD=

# Webhooks reject plain HTTP by default. Set this only for trusted local test targets.
# OPENBOX_ALLOW_HTTP_WEBHOOKS=1

# Gameyfin plain HTTP is blocked by default. Set this only for trusted local servers.
# OPENBOX_ALLOW_HTTP_GAMEYFIN=1
